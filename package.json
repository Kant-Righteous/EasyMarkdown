{
  "name": "easymarkdown",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "android:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/android-dev.ps1",
    "android:build": "tauri android build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "dev": "npm run dev:desktop",
    "dev:desktop": "vite --mode desktop",
    "dev:mobile": "vite --mode mobile",
    "build": "npm run build:desktop",
    "build:desktop": "tsc && vite build --mode desktop",
    "build:mobile": "tsc && vite build --mode mobile",
    "test": "node --test --experimental-strip-types",
    "preview": "vite preview",
    "tauri": "tauri",
    "copyright:source": "node scripts/generate-softcopyright-source.mjs"
  },
  "dependencies": {
    "@mdit/plugin-footnote": "^0.23.2",
    "@mdit/plugin-katex": "^0.25.2",
    "@mdit/plugin-mark": "^0.23.2",
    "@mdit/plugin-tasklist": "^0.23.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "mermaid": "^11.15.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
